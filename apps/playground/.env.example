# Copy to apps/playground/.env.local. That file is gitignored.

TOOLPA_MODEL_PROVIDER=cloudflare-gateway
TOOLPA_ALLOW_NETWORK=1
TOOLPA_MODEL=workers-ai/@cf/openai/gpt-oss-120b
CF_ACCOUNT_ID=
CF_GATEWAY_ID=
CF_AIG_TOKEN=

# Vercel AI Gateway instead of Cloudflare:
# TOOLPA_MODEL_PROVIDER=vercel-gateway
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-haiku
# AI_GATEWAY_BASE_URL=

# Optional provider keys when TOOLPA_MODEL is anthropic/... or openai/... through Cloudflare:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
