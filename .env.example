# Required for local AI generation. Leave blank to run the app with AI disabled.
AI_GATEWAY_API_KEY=

# Optional. Defaults to deepseek/deepseek-v4-flash when unset.
AI_GATEWAY_MODEL=deepseek/deepseek-v4-flash

# Optional. Bounds evolving-fm-synth gateway requests in milliseconds.
# SYNTH_GATEWAY_TIMEOUT_MS=25000

# Optional. Use the AI tool-loop builder instead of the default skeleton builder.
# TOOLPA_JS_BUILDER_MODE=tool-loop

# Optional. Builder timeout in milliseconds. Default: 90000.
# TOOLPA_JS_BUILDER_TIMEOUT_MS=90000

# Optional. Prompt logs write to .memory/prompts by default.
# TOOLPA_PROMPT_MEMORY_DISABLED=1
# TOOLPA_PROMPT_MEMORY_DIR=.memory/prompts

# Optional. Override the local source directory for sample-suite curation.
# AUDIO_SAMPLES_ROOT=/Users/you/Documents/Audio Samples

# Optional. Override the Essentia MusiCNN model URL used by sample analysis.
# MUSICNN_MODEL_URL=https://example.com/model.json
